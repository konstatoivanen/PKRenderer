Material:
    Shader: Content/Shaders/MS_Mat_Surf_Default.pkshader
    ShaderShadow: Content/Shaders/MS_Mat_Shadow_Default.pkshader
    Properties:
        _AlbedoTexture:
            Type: Texture2D
            Value: Content/Textures/Environment/T_Asphalt_D.pktexture
        _PBSTexture:
            Type: Texture2D
            Value: Content/Textures/Environment/T_Asphalt_S.pktexture
        _NormalMap:
            Type: Texture2D
            Value: Content/Textures/Environment/T_Asphalt_N.pktexture
        _HeightMap:
            Type: Texture2D
            Value: Content/Textures/Environment/T_Asphalt_H.pktexture
        _EmissionTexture:
            Type: Texture2D
            Value: Content/Textures/Environment/T_EmissiveTest_E.pktexture
        _Color:
            Type: Float4
            Value: [1,1,1,1]
        _EmissionColor:
            Type: Float4
            Value: [1,1,1,1]
        _Metallic:
            Type: Float
            Value: 1
        _Roughness:
            Type: Float
            Value: 1
        _Occlusion:
            Type: Float
            Value: 1
        _HeightAmount:
            Type: Float
            Value: 0.05
        _NormalAmount:
            Type: Float
            Value: 0.4