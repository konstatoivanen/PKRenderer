Material:
    Shader: Content/Shaders/MS_Mat_Surf_Cloth.pkshader
    ShaderShadow: Content/Shaders/MS_Mat_Shadow_Default.pkshader
    Properties:
        _AlbedoTexture:
            Type: Texture2D
            Value: Content/Textures/Environment/T_Cloth_D.pktexture
        _PBSTexture:
            Type: Texture2D
            Value: Content/Textures/Environment/T_Cloth_S.pktexture
        _HeightMap:
            Type: Texture2D
            Value: Content/Textures/Environment/T_Cloth_H.pktexture
        _Color:
            Type: Float4
            Value: [0,0.5,0.5,1]
        _SheenColor:
            Type: Float4
            Value: [0.6, 0.7, 0.5, 1]
        _Metallic:
            Type: Float
            Value: 0.0
        _Roughness:
            Type: Float
            Value: 0.75
        _Occlusion:
            Type: Float
            Value: 1
        _HeightAmount:
            Type: Float
            Value: 0.05
        _NormalAmount:
            Type: Float
            Value: 1.0